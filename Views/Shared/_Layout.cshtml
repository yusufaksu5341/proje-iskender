<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <nav class="fire-navbar">
        <div class="container-fluid d-flex align-items-center" style="gap:1rem; min-height:60px;">

            <a class="navbar-brand-fire" asp-controller="Home" asp-action="Index">
                İskender
            </a>

            <div class="nav-search-wrap d-none d-md-block">
                <div class="nav-search">
                    <input type="text" placeholder="Ürün, kategori veya satıcı ara..." />
                    <button>Ara</button>
                </div>
            </div>

            <ul class="navbar-nav flex-row d-none d-lg-flex ms-2" style="gap:.2rem;">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">İlanlar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Açık Artırma</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Satıcılar</a>
                </li>
            </ul>

            <div class="flex-grow-1"></div>

            <div class="d-flex align-items-center gap-2">
                @{
                    var sessionUser = Context.Session.GetString("Username");
                }
                @if (!string.IsNullOrEmpty(sessionUser))
                {
                    <a asp-controller="Listing" asp-action="Add" class="btn-nav-register d-none d-sm-inline-block">+ İlan Ver</a>
                    <div class="nav-user-pill d-none d-sm-flex">
                        <span class="nav-user-at">@@</span>
                        <span class="nav-user-name">@sessionUser</span>
                        <a asp-controller="Account" asp-action="Logout" class="nav-user-logout" title="Çıkış Yap">⏻</a>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-nav-login d-none d-sm-inline-block">Giriş</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-nav-register d-none d-sm-inline-block">Kayıt Ol</a>
                }
                <button class="hamburger d-lg-none" id="menuToggle" aria-label="Menü">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>

        <div class="mobile-menu" id="mobileMenu">
            <div class="mobile-search">
                <div class="nav-search">
                    <input type="text" placeholder="Ürün ara..." />
                    <button>Ara</button>
                </div>
            </div>
            <ul class="mobile-nav-links">
                <li><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                <li><a href="#">İlanlar</a></li>
                <li><a href="#">Açık Artırma</a></li>
                <li><a href="#">Satıcılar</a></li>
            </ul>
            <div class="mobile-auth">
                <a asp-controller="Account" asp-action="Login" class="btn-nav-login">Giriş Yap</a>
                <a asp-controller="Account" asp-action="Register" class="btn-nav-register">Kayıt Ol</a>
            </div>
        </div>
    </nav>

    <div class="category-strip">
        <div class="container-fluid">
            <ul>
                <li><a href="#">Oyun & Konsol</a></li>
                <li><a href="#">Telefon & Tablet</a></li>
                <li><a href="#">Bilgisayar</a></li>
                <li><a href="#">Fotoğraf</a></li>
                <li><a href="#">Müzik</a></li>
                <li><a href="#">Giyim</a></li>
                <li><a href="#">Ev & Yaşam</a></li>
                <li><a href="#">Araç & Aksesuar</a></li>
                <li><a href="#">Saat & Mücevher</a></li>
                <li><a href="#">Kitap & Koleksiyon</a></li>
                <li><a href="#" style="color:var(--fire-orange);">Tüm Kategoriler</a></li>
            </ul>
        </div>
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="fire-footer">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <div class="footer-brand">İskender</div>
                    <p class="footer-desc">
                        Türkiye'nin en güvenilir 2. el alım-satım ve açık artırma platformu.
                    </p>
                </div>
                <div class="col-6 col-md-2">
                    <div class="footer-title">Keşfet</div>
                    <ul class="footer-links">
                        <li><a href="#">Tüm İlanlar</a></li>
                        <li><a href="#">Aktif Artırmalar</a></li>
                        <li><a href="#">Çok Satanlar</a></li>
                        <li><a href="#">Yeni Eklenenler</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <div class="footer-title">Hesap</div>
                    <ul class="footer-links">
                        <li><a href="#">Giriş Yap</a></li>
                        <li><a href="#">Kayıt Ol</a></li>
                        <li><a href="#">İlanlarım</a></li>
                        <li><a href="#">Tekliflerim</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <div class="footer-title">Yardım</div>
                    <ul class="footer-links">
                        <li><a href="#">Nasıl Çalışır?</a></li>
                        <li><a href="#">Güvenli Alışveriş</a></li>
                        <li><a href="#">İletişim</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <div class="footer-title">Yasal</div>
                    <ul class="footer-links">
                        <li><a href="#">Gizlilik</a></li>
                        <li><a href="#">Kullanım Şartları</a></li>
                        <li><a href="#">KVKK</a></li>
                    </ul>
                </div>
            </div>
           
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
