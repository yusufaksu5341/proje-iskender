@{
    ViewData["Title"] = "İskender";
}

<section class="hero-section">
    <div class="ember-field">
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
    </div>

    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-12 col-lg-6 hero-content">
                <h1 class="hero-title">
                    İskender'de<br />
                    Fırsatını Yakala
                </h1>
                <p class="hero-sub">
                    <strong>İskender</strong> ile 2. el alım-satımda
                    açık artırmaya katıl, kaçırılmaz fırsatları ele geçir.
                </p>
                <div class="hero-stats">
                    <div class="hero-stat">
                        <span class="hero-stat-num">48K+</span>
                        <span class="hero-stat-lbl">Aktif İlan</span>
                    </div>
                    <div class="hero-stat">
                        <span class="hero-stat-num">12K+</span>
                        <span class="hero-stat-lbl">Satıcı</span>
                    </div>
                    <div class="hero-stat">
                        <span class="hero-stat-num">320</span>
                        <span class="hero-stat-lbl">Açık Artırma</span>
                    </div>
                </div>
                <div class="hero-actions">
                    <a href="#" class="btn-fire">İlanlara Gözat</a>
                    <a href="#" class="btn-fire-outline">İlan Ver</a>
                </div>
            </div>
            <div class="col-12 col-lg-6 d-none d-lg-block">
                <div class="hero-card-showcase">
                    <div class="showcase-card card-left">
                        <div class="sc-img"></div>
                        <div class="sc-title">Fender Stratocaster</div>
                        <div class="sc-price">₺28.500</div>
                        <div class="sc-bid">7 teklif</div>
                    </div>
                    <div class="showcase-card card-main">
                        <span class="sc-badge">Çok Teklif</span>
                        <div class="sc-img"></div>
                        <div class="sc-title">PlayStation 5 Pro — 2. El</div>
                        <div class="sc-price">₺18.500</div>
                        <div class="sc-bid">14 teklif · 2s 34d kaldi</div>
                    </div>
                    <div class="showcase-card card-right">
                        <div class="sc-img"></div>
                        <div class="sc-title">Leica M11 Body</div>
                        <div class="sc-price">₺95.000</div>
                        <div class="sc-bid">3 teklif</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
