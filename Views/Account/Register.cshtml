@{
    ViewData["Title"] = "Kayıt Ol — İskender";
    Layout = "_AuthLayout";
}

<div class="legal-modal-backdrop" id="termsModal">
    <div class="legal-modal">
        <div class="legal-modal-header">
            <span class="legal-modal-title">Kullanım Şartları</span>
            <button type="button" class="legal-modal-close" id="termsClose">✕</button>
        </div>
        <div class="legal-modal-body">
            @for (int i = 0; i < 20; i++) {
                <p>tüm verilerini satıcaz</p>
            }
        </div>
    </div>
</div>

<div class="legal-modal-backdrop" id="privacyModal">
    <div class="legal-modal">
        <div class="legal-modal-header">
            <span class="legal-modal-title">Gizlilik Politikası</span>
            <button type="button" class="legal-modal-close" id="privacyClose">✕</button>
        </div>
        <div class="legal-modal-body">
            @for (int i = 0; i < 20; i++) {
                <p>tüm verilerini satıcaz</p>
            }
        </div>
    </div>
</div>

<div class="auth-page">
    <div class="auth-embers">
        <div class="auth-ember"></div>
        <div class="auth-ember"></div>
        <div class="auth-ember"></div>
        <div class="auth-ember"></div>
        <div class="auth-ember"></div>
    </div>

    <div class="auth-card">
        <div class="auth-brand">İskender</div>
        <div class="auth-title">Aramıza Katıl</div>
        <div class="auth-subtitle">Ücretsiz hesap oluştur, alım-satıma başla.</div>

        @if (ViewBag.Error != null)
        {
            <div class="auth-alert">@ViewBag.Error</div>
        }

        <form class="auth-form" method="post" asp-controller="Account" asp-action="Register" id="registerForm" novalidate>
            <div class="auth-field">
                <label class="auth-label" for="email">E-posta</label>
                <input class="auth-input" type="email" id="email" name="email"
                       autocomplete="email" required />
                <div class="auth-field-error" id="emailErr">Geçerli bir e-posta adresi girin.</div>
            </div>

            <div class="auth-field">
                <label class="auth-label" for="username">Kullanıcı Adı</label>
                <div class="auth-input-prefix-wrap">
                    <span class="auth-prefix">@@</span>
                    <input class="auth-input has-prefix" type="text" id="username" name="username"
                           autocomplete="username" required />
                </div>
                <div class="auth-field-error" id="usernameErr">Kullanıcı adı en az 3 karakter olmalı.</div>
            </div>

            <div class="auth-field">
                <label class="auth-label" for="password">Şifre</label>
                <div class="auth-input-wrap">
                    <input class="auth-input" type="password" id="password" name="password"
                           autocomplete="new-password" required />
                    <button type="button" class="auth-eye" id="togglePwd" aria-label="Şifreyi göster">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <div class="pwd-strength" id="pwdStrength">
                    <div class="pwd-bar"><div class="pwd-fill" id="pwdFill"></div></div>
                    <span class="pwd-label" id="pwdLabel">Şifre gücü</span>
                </div>
                <div class="auth-field-error" id="pwdErr">Şifre en az 8 karakter olmalı.</div>
            </div>

            <div class="auth-field">
                <label class="auth-label" for="passwordConfirm">Şifre Tekrar</label>
                <div class="auth-input-wrap">
                    <input class="auth-input" type="password" id="passwordConfirm" name="passwordConfirm"
                           autocomplete="new-password" required />
                    <button type="button" class="auth-eye" id="togglePwd2" aria-label="Şifreyi göster">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <div class="auth-field-error" id="confirmErr">Şifreler uyuşmuyor.</div>
            </div>

            <div class="auth-terms">
                <label class="auth-check-wrap">
                    <input type="checkbox" name="terms" id="termsCheck" required />
                    <span class="auth-checkmark"></span>
                    <span>
                        <a class="auth-link" id="termsLink">Kullanım Şartları</a> ve
                        <a class="auth-link" id="privacyLink">Gizlilik Politikası</a>'nı kabul ediyorum.
                    </span>
                </label>
            </div>

            <button type="submit" class="btn-fire w-100 auth-submit">Hesap Oluştur</button>
        </form>

        <div class="auth-switch">
            Zaten hesabın var mı?
            <a asp-controller="Account" asp-action="Login">Giriş Yap</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('togglePwd')?.addEventListener('click', function() {
        const pwd = document.getElementById('password');
        pwd.type = pwd.type === 'password' ? 'text' : 'password';
        this.classList.toggle('active');
    });
    document.getElementById('togglePwd2')?.addEventListener('click', function() {
        const pwd = document.getElementById('passwordConfirm');
        pwd.type = pwd.type === 'password' ? 'text' : 'password';
        this.classList.toggle('active');
    });

    const pwdInput   = document.getElementById('password');
    const pwdConfirm = document.getElementById('passwordConfirm');
    const pwdFill    = document.getElementById('pwdFill');
    const pwdLabel   = document.getElementById('pwdLabel');
    const emailInput = document.getElementById('email');
    const usernameInput = document.getElementById('username');

    function calcStrength(val) {
        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;
        return score;
    }

    pwdInput?.addEventListener('input', function() {
        const val = this.value;
        const score = val.length === 0 ? 0 : calcStrength(val);
        const levels = [
            { pct: '0%',   color: 'transparent', label: 'Şifre gücü' },
            { pct: '25%',  color: '#ff2d00',      label: 'Zayıf' },
            { pct: '50%',  color: '#ff6b00',      label: 'Orta' },
            { pct: '75%',  color: '#ffb700',       label: 'İyi' },
            { pct: '100%', color: '#00cc55',       label: 'Güçlü' },
        ];
        pwdFill.style.width      = levels[score].pct;
        pwdFill.style.background = levels[score].color;
        pwdLabel.textContent     = levels[score].label;
        pwdLabel.style.color     = levels[score].color === 'transparent' ? '' : levels[score].color;

        const errEl = document.getElementById('pwdErr');
        if (val.length > 0 && val.length < 8) {
            errEl.classList.add('show');
            this.classList.add('input-error'); this.classList.remove('input-ok');
        } else if (val.length >= 8) {
            errEl.classList.remove('show');
            this.classList.remove('input-error'); this.classList.add('input-ok');
        } else {
            errEl.classList.remove('show');
            this.classList.remove('input-error', 'input-ok');
        }

        if (pwdConfirm.value.length > 0) pwdConfirm.dispatchEvent(new Event('input'));
    });

    pwdConfirm?.addEventListener('input', function() {
        const errEl = document.getElementById('confirmErr');
        if (this.value.length === 0) {
            errEl.classList.remove('show');
            this.classList.remove('input-error', 'input-ok');
        } else if (this.value !== pwdInput.value) {
            errEl.classList.add('show');
            this.classList.add('input-error'); this.classList.remove('input-ok');
        } else {
            errEl.classList.remove('show');
            this.classList.remove('input-error'); this.classList.add('input-ok');
        }
    });

    emailInput?.addEventListener('blur', function() {
        const errEl = document.getElementById('emailErr');
        const valid = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(this.value);
        if (this.value.length === 0) {
            errEl.classList.remove('show');
            this.classList.remove('input-error', 'input-ok');
        } else if (!valid) {
            errEl.classList.add('show');
            this.classList.add('input-error'); this.classList.remove('input-ok');
        } else {
            errEl.classList.remove('show');
            this.classList.remove('input-error'); this.classList.add('input-ok');
        }
    });

    usernameInput?.addEventListener('blur', function() {
        const errEl = document.getElementById('usernameErr');
        if (this.value.length > 0 && this.value.length < 3) {
            errEl.classList.add('show');
            this.classList.add('input-error'); this.classList.remove('input-ok');
        } else if (this.value.length >= 3) {
            errEl.classList.remove('show');
            this.classList.remove('input-error'); this.classList.add('input-ok');
        } else {
            errEl.classList.remove('show');
            this.classList.remove('input-error', 'input-ok');
        }
    });

    document.getElementById('registerForm')?.addEventListener('submit', function(e) {
        let ok = true;

        const emailVal = emailInput.value;
        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailVal)) {
            document.getElementById('emailErr').classList.add('show');
            emailInput.classList.add('input-error');
            ok = false;
        }

        if (usernameInput.value.length < 3) {
            document.getElementById('usernameErr').classList.add('show');
            usernameInput.classList.add('input-error');
            ok = false;
        }

        if (pwdInput.value.length < 8) {
            document.getElementById('pwdErr').classList.add('show');
            pwdInput.classList.add('input-error');
            ok = false;
        }

        if (pwdConfirm.value !== pwdInput.value) {
            document.getElementById('confirmErr').classList.add('show');
            pwdConfirm.classList.add('input-error');
            ok = false;
        }

        if (!ok) e.preventDefault();
    });

    function openModal(id) { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    document.getElementById('termsLink')?.addEventListener('click',   e => { e.preventDefault(); openModal('termsModal');   });
    document.getElementById('privacyLink')?.addEventListener('click', e => { e.preventDefault(); openModal('privacyModal'); });
    document.getElementById('termsClose')?.addEventListener('click',  () => closeModal('termsModal'));
    document.getElementById('privacyClose')?.addEventListener('click',() => closeModal('privacyModal'));
    document.getElementById('termsModal')?.addEventListener('click',  e => { if (e.target === e.currentTarget) closeModal('termsModal');   });
    document.getElementById('privacyModal')?.addEventListener('click',e => { if (e.target === e.currentTarget) closeModal('privacyModal'); });
</script>
}
