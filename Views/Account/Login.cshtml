@{
    ViewData["Title"] = "Giriş Yap — İskender";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">İskender</div>
        <div class="auth-title">Tekrar Hoş Geldin</div>

        @if (ViewBag.Error != null)
        {
            <div class="auth-alert">@ViewBag.Error</div>
        }

        <form class="auth-form" method="post" asp-controller="Account" asp-action="Login">
            <div class="auth-field">
                <label class="auth-label" for="identifier">Kullanıcı Adı veya E-posta</label>
                <input class="auth-input" type="text" id="identifier" name="identifier"
                       autocomplete="username" required />
            </div>

            <div class="auth-field">
                <label class="auth-label" for="password">
                    Şifre
                    <a href="#" class="auth-forgot">Şifremi Unuttum</a>
                </label>
                <div class="auth-input-wrap">
                    <input class="auth-input" type="password" id="password" name="password"
                           autocomplete="current-password" required />
                    <button type="button" class="auth-eye" id="togglePwd" aria-label="Şifreyi göster">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-fire w-100 auth-submit">Giriş Yap</button>
        </form>

        <div class="auth-switch">
            Hesabın yok mu?
            <a asp-controller="Account" asp-action="Register">Kayıt Ol</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const btn = document.getElementById('togglePwd');
    const pwd = document.getElementById('password');
    btn?.addEventListener('click', () => {
        pwd.type = pwd.type === 'password' ? 'text' : 'password';
        btn.classList.toggle('active');
    });
</script>
}
